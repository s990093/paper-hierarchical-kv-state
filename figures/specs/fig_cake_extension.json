{
  "title": "以 Cake 為基底的位置感知 KV 分層架構",
  "canvas": {"width": 980, "height": 760},
  "style": {"font_family": "WenQuanYi Zen Hei, Noto Sans CJK TC, sans-serif", "font_size": 14, "bg_color": "#FFFFFF"},
  "nodes": [
    {"id": "front", "label": "前段 block", "sublabel": "重算便宜", "x": 120, "y": 175, "width": 150, "height": 56, "fill": "#DCFCE7", "stroke": "#16A34A"},
    {"id": "mid",   "label": "中段 block", "sublabel": "重算中等", "x": 120, "y": 270, "width": 150, "height": 56, "fill": "#FEF9C3", "stroke": "#CA8A04"},
    {"id": "back",  "label": "後段 block", "sublabel": "重算最貴", "x": 120, "y": 365, "width": 150, "height": 56, "fill": "#FEE2E2", "stroke": "#DC2626"},

    {"id": "consts", "label": "實測成本常數", "sublabel": "κ＝重算÷傳輸、每筆搬運固定成本", "x": 455, "y": 95, "width": 250, "height": 58, "fill": "#F1F5F9", "stroke": "#64748B"},
    {"id": "policy", "label": "位置感知策略\n① 寫入：這段存不存\n② 放置：放哪一層\n③ 逐出：從前段開始丟", "x": 455, "y": 270, "width": 230, "height": 130, "fill": "#E0E7FF", "stroke": "#4F46E5"},

    {"id": "gpu",  "label": "GPU HBM", "sublabel": "最快、最小", "x": 820, "y": 150, "width": 170, "height": 54, "fill": "#FFFFFF", "stroke": "#334155"},
    {"id": "cpu",  "label": "CPU 記憶體", "sublabel": "中等", "x": 820, "y": 235, "width": 170, "height": 54, "fill": "#FFFFFF", "stroke": "#334155"},
    {"id": "ssd",  "label": "SSD", "sublabel": "慢、大", "x": 820, "y": 320, "width": 170, "height": 54, "fill": "#FFFFFF", "stroke": "#334155"},
    {"id": "drop", "label": "不存", "sublabel": "要用時重算", "x": 820, "y": 405, "width": 170, "height": 54, "fill": "#F8FAFC", "stroke": "#94A3B8"},

    {"id": "rd_gpu", "label": "GPU 從前段往後重算", "x": 175, "y": 590, "width": 210, "height": 54, "fill": "#DCFCE7", "stroke": "#16A34A"},
    {"id": "meet",   "label": "會合點\n跑到哪算到哪", "x": 490, "y": 590, "width": 170, "height": 90, "shape": "diamond", "fill": "#FFFFFF", "stroke": "#4F46E5"},
    {"id": "rd_io",  "label": "I/O 從後段往前載入", "x": 805, "y": 590, "width": 210, "height": 54, "fill": "#FEE2E2", "stroke": "#DC2626"},
    {"id": "fallback", "label": "退路：一邊明顯較快，就只走那一邊", "x": 490, "y": 700, "width": 330, "height": 44, "fill": "#FFF7ED", "stroke": "#EA580C"}
  ],
  "edges": [
    {"from": "front", "to": "policy"},
    {"from": "mid", "to": "policy"},
    {"from": "back", "to": "policy"},
    {"from": "consts", "to": "policy", "label": "決定分界", "style": "dashed"},
    {"from": "policy", "to": "gpu", "label": "後段"},
    {"from": "policy", "to": "cpu", "label": "中段"},
    {"from": "policy", "to": "ssd", "label": "較冷的"},
    {"from": "policy", "to": "drop", "label": "前段"},
    {"from": "rd_gpu", "to": "meet"},
    {"from": "rd_io", "to": "meet"},
    {"from": "meet", "to": "fallback", "style": "dashed"}
  ],
  "groups": [
    {"id": "g_seq", "label": "一段長上下文（32K–128K）", "node_ids": ["front", "mid", "back"], "fill": "#FAFAFA", "stroke": "#D4D4D8"},
    {"id": "g_new", "label": "寫入時決定（Cake 沒有，本提案新增）", "node_ids": ["consts", "policy"], "fill": "#EEF2FF", "stroke": "#A5B4FC"},
    {"id": "g_tier", "label": "儲存層", "node_ids": ["gpu", "cpu", "ssd", "drop"], "fill": "#F8FAFC", "stroke": "#CBD5E1"},
    {"id": "g_read", "label": "讀取時：雙向還原（Cake 已有；本提案加入實測成本與退路）", "node_ids": ["rd_gpu", "meet", "rd_io", "fallback"], "fill": "#FFFBEB", "stroke": "#FCD34D"}
  ],
  "labels": [
    {"text": "命中時 ↓（前段大多不必存，因為讀取時本來就會重算）", "x": 490, "y": 492, "font_size": 13, "color": "#475569", "anchor": "middle"}
  ]
}
